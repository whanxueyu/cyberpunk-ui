{
  "name": "cyberpunk-ui",
  "private": false,
  "version": "1.1.1",
  "scripts": {
    "build:types": "vue-tsc --project tsconfig.package.json --declaration --emitDeclarationOnly --declarationDir ./lib/types",
    "build:vite": "vite build",
    "build:rename-css": "node -e \"const fs=require('fs');const path=require('path');const oldPath=path.join(__dirname,'lib/cyberpunk-ui.css');const newPath=path.join(__dirname,'lib/style.css');if(fs.existsSync(oldPath)){fs.renameSync(oldPath,newPath);console.log('Renamed cyberpunk-ui.css to style.css');}\"",
    "build": "npm run build:types && npm run build:vite && npm run build:rename-css",
    "preview": "vite preview",
    "test:dev": "pnpm -C test dev",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build"
  },
  "dependencies": {
    "sass": "^1.77.8",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/runtime-core": "^3.4.34",
    "@vue/shared": "^3.4.34",
    "typescript": "^5.2.2",
    "vite": "^7.0.0",
    "vue-tsc": "^2.0.24"
  },
  "author": "anxueyu",
  "description": "cyberpunk-ui,cyberpunk,cyberpunkUI",
  "keywords": [
    "cyberpunk-ui"
  ],
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "files": [
    "lib/*",
    "lib/types/**/*",
    "package/*",
    "global.d.ts",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "main": "./lib/cyberpunk-ui.umd.js",
  "module": "./lib/cyberpunk-ui.mjs",
  "types": "./lib/types/cyberpunk-ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/cyberpunk-ui/index.d.ts",
      "import": "./lib/cyberpunk-ui.mjs",
      "require": "./lib/cyberpunk-ui.umd.js"
    },
    "./lib/style.css": "./lib/style.css",
    "./global": "./global.d.ts"
  },
  "engines": {
    "node": ">=18.18.2"
  }
}
